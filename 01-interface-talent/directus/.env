# Porta exposta pelo Directus
PORT=8055
PUBLIC_URL=http://localhost:8055

# Credenciais admin do Directus (login inicial)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# Chaves "secretas" do Directus (JWT/signing)
KEY=supersecretkey
SECRET=supersecretsecret

# Banco Postgres interno
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=leapy
POSTGRES_PORT=5432

# Os serviços rodam em Docker network. O Directus acessa o Postgres via hostname "postgres"
# então não precisamos DB_HOST aqui porque já está hardcoded no compose:
#   DB_HOST: postgres
# e DB_CLIENT=pg, DB_PORT=5432 já estão no compose.
